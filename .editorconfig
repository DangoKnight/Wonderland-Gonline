root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{html,htm}]
indent_style = tab
indent_size = 4

[*.{css,scss,less}]
indent_style = tab
indent_size = 4

[*.{js,mjs,cjs,ts}]
indent_style = tab
indent_size = 4

[*.json]
indent_style = tab
indent_size = 4

[*.md]
indent_style = tab
trim_trailing_whitespace = false

[*.{yml,yaml}]
# YAML specification forbids tabs for indentation
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
