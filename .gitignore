/var/
/bin/
/coverage.out
/config.local.json
/node_modules/
/client/assets/
/client/reference/
__pycache__/

# Client-derived tables, media, sprite payloads and manifests are regenerated
# from the original installation. Keep local copies, documentation and the
# server-only definitions that cannot be reconstructed from that client.
/data/*
!/data/import_resources.go
!/data/README.md
!/data/server/
!/data/runtime/
/data/runtime/*
!/data/runtime/locales/
/data/runtime/locales/*
!/data/runtime/locales/en.json
!/data/runtime/locales/zh-TW.json
!/data/runtime/locales/README.md
!/data/sprites/
/data/sprites/*
!/data/sprites/*.md
!/data/pictures/
/data/pictures/*
!/data/pictures/*.md

# Generated native-resource inventories and first-build PNG dimension baseline.
/client/assets-manifest.json
/client/asset-packages.json
/client/asset-contract.json

# Documented data mining
/docs/References/*

.claude/

*.pyc

# Generated workbook inspections; keep the authored workbook itself.
*.xlsx.inspect.ndjson
